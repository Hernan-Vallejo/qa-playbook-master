# =============================================================================
# Variables de entorno de la plantilla de automation
# =============================================================================
# Uso:
#   1. Copiá este archivo con el nombre ".env" (cp .env.example .env).
#   2. Ajustá los valores a tu ambiente.
#   3. El archivo ".env" NO se sube al repositorio (está en .gitignore).
#
# Todas las variables son opcionales: si no existen, se usan los valores por
# defecto que se indican en cada línea (ver playwright.config.ts, config/ambientes.ts y data/*.ts).
# =============================================================================

# --- Ambiente -----------------------------------------------------------------

# Nombre del ambiente a probar: demo | qa | pre. Las URLs de cada uno están en config/ambientes.ts.
# Por defecto: demo (sitio público SauceDemo y API pública de práctica).
# "prod" NO es válido: nunca se prueba en producción y la ejecución se corta con un error.
TEST_ENV=demo

# URL de la aplicación web. Si la definís, pisa a la de TEST_ENV.
# BASE_URL=https://qa.example.com

# URL de la API. Si la definís, pisa a la de TEST_ENV.
# API_URL=https://api.qa.example.com

# Textos que NO pueden aparecer en las URLs (hosts de producción), separados por comas.
# Si alguna URL contiene uno de ellos, la ejecución se corta. Segunda barrera de seguridad.
# HOSTS_BLOQUEADOS=www.mi-empresa.com,api.mi-empresa.com

# --- Navegador ----------------------------------------------------------------

# Navegadores a usar, separados por comas: chromium | firefox | webkit | movil.
# Con más de uno, los tests corren una vez por navegador. Por defecto: chromium.
BROWSERS=chromium

# true  = el navegador corre sin ventana (recomendado en CI).
# false = se ve el navegador (útil para depurar en tu equipo).
HEADLESS=true

# Milisegundos de pausa entre acciones, solo para poder "ver" la prueba.
# 0 = sin pausa (valor normal). 700 = pausa visible, útil para demostraciones.
SLOW_MO=0

# Navegador instalado en tu equipo a usar en lugar del Chromium de Playwright.
# Valores posibles: msedge, chrome. Vacío = usa el Chromium que descarga Playwright.
# Solo afecta al navegador "chromium".
BROWSER_CHANNEL=

# --- Credenciales de prueba ---------------------------------------------------

# Usuario y clave de prueba. Los valores por defecto son los del sitio demo público
# (no son secretos). En un proyecto real, pedí el usuario de prueba al equipo y
# pasalo por variables de entorno o por el gestor de secretos del CI; nunca en el código.
QA_USER=standard_user
QA_PASSWORD=secret_sauce
