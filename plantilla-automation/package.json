{
  "name": "plantilla-automation",
  "version": "1.0.0",
  "description": "Plantilla de automatización de pruebas de front con Playwright, TypeScript y Page Object Model (POM). Usa el sitio demo público SauceDemo.",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:web": "playwright test --project=chromium-sin-sesion --project=chromium-con-sesion",
    "test:api": "playwright test --project=api",
    "test:login": "playwright test tests/sin-sesion/login.spec.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^16.4.5",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
